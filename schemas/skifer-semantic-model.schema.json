{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skifer.io/schemas/semantic-model/v1",
  "title": "Skifer semantic model document",
  "description": "Necessary structural validation. Run SemanticValidator for the complete verdict.",
  "type": "object",
  "required": [
    "models"
  ],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Model"
      }
    }
  },
  "$defs": {
    "Model": {
      "type": "object",
      "required": [
        "name",
        "table",
        "dimensions",
        "metrics"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Dimension"
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Metric"
          }
        },
        "entities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "relationships": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Relationship"
          }
        },
        "grain": {
          "description": "Legacy parser ignores non-string/non-array grain values and empty strings.",
          "allOf": [
            {
              "if": {
                "type": "string",
                "minLength": 1
              },
              "then": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            {
              "if": {
                "type": "array"
              },
              "then": {
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "uniqueItems": true
              }
            }
          ]
        },
        "calendar": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_policy": {
          "type": "object",
          "required": [
            "column",
            "attribute"
          ],
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "attribute": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "description": {},
        "synonyms": {},
        "layer": {},
        "base_filter": {},
        "default_time_dimension": {},
        "metadata": {}
      }
    },
    "Dimension": {
      "type": "object",
      "required": [
        "name",
        "sql"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Non-standard values only warn. Standard types: boolean, date, datetime, float, integer, string, timestamp"
        },
        "description": {},
        "synonyms": {}
      }
    },
    "Metric": {
      "type": "object",
      "required": [
        "name",
        "sql",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^(?:[aA][vV][gG]|[cC][oO][uU][nN][tT]|[cC][oO][uU][nN][tT]_[dD][iI][sS][tT][iI][nN][cC][tT]|[mM][aA][xX]|[mM][iI][nN]|[sS][uU][mM])$"
        },
        "additivity": {
          "enum": [
            "additive",
            "non_additive",
            "semi_additive"
          ]
        },
        "non_additive_dimensions": {},
        "filters": {
          "description": "Malformed inline filters only warn; retain validator acceptance."
        },
        "description": {},
        "synonyms": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "additivity": {
                "const": "semi_additive"
              }
            },
            "required": [
              "additivity"
            ]
          },
          "then": {
            "required": [
              "non_additive_dimensions"
            ],
            "properties": {
              "non_additive_dimensions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "additivity": {
                "const": "additive"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "non_additive_dimensions"
              ]
            }
          }
        }
      ]
    },
    "Entity": {
      "type": "object",
      "required": [
        "name",
        "type",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "foreign",
            "primary",
            "unique"
          ]
        },
        "key": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "Relationship": {
      "type": "object",
      "required": [
        "name",
        "from_entity",
        "to_model",
        "to_entity",
        "cardinality",
        "join_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "from_entity": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "to_model": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "to_entity": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "cardinality": {
          "enum": [
            "many_to_many",
            "many_to_one",
            "one_to_many",
            "one_to_one"
          ],
          "description": "The validator explicitly refuses unknown cardinality."
        },
        "join_type": {
          "enum": [
            "inner",
            "left"
          ]
        },
        "verified_by_contract": {
          "description": "Legacy validator uses truthiness, without a type restriction."
        }
      }
    }
  }
}
